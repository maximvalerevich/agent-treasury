# MultiHopper environment. Devnet keys are minted on the DEVNET dashboard and are
# NOT interchangeable with production: https://devnet.multihopper.com/developer/dashboard
MH_BASE_URL=https://devnet.multihopper.com/api/v1
MH_API_KEY=mh_test_replace_me

# Base58 secret key of the treasury wallet that signs the transfer bundles.
# Devnet only. Never commit a real key.
TREASURY_KEYPAIR_B58=

# Solana RPC used for broadcast and confirmation.
SOLANA_RPC_URL=https://api.devnet.solana.com

# HMAC secret for webhook signature verification (x-multihopper-signature).
MH_WEBHOOK_SECRET=whsec_replace_me

# Policy limits for agent spending.
POLICY_PER_TX_LIMIT_USD=250
POLICY_DAILY_LIMIT_USD=1000
POLICY_APPROVAL_THRESHOLD_USD=100
POLICY_ALLOWED_RECIPIENTS=
